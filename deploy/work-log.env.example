# Work Log service configuration
# Installed at /etc/work-log/work-log.env, owned root:work-log, mode 0640.

# SQLite database (the only file the service writes).
WORK_LOG_DB=/var/lib/work-log/work_log.db

# Bind address. Keep 127.0.0.1 when a reverse proxy (nginx/caddy) sits in
# front; use 0.0.0.0 to expose the app directly.
WORK_LOG_HOST=127.0.0.1
WORK_LOG_PORT=8000

# SQLite is a single-writer database: keep one worker unless you know better.
WORK_LOG_WORKERS=1

# Only these peers may set X-Forwarded-* headers (proxy IPs / CIDRs).
WORK_LOG_FORWARDED_IPS=127.0.0.1

# debug | info | warning | error | critical
WORK_LOG_LOG_LEVEL=info
